{
  "name": "solana-multiwallet-bot",
  "version": "1.1.0",
  "description": "Telegram bot for coordinated multi-wallet Pump.fun operations on Solana (50 wallets)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "generate-wallets": "ts-node scripts/generate-wallets.ts",
    "encrypt-store": "ts-node scripts/encrypt-store.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["solana", "telegram", "multiwallet", "bot", "pump.fun"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.95.4",
    "@solana/spl-token": "^0.4.9",
    "@pump-fun/pump-sdk": "^1.26.0",
    "bn.js": "^5.2.1",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "bs58": "^6.0.0",
    "telegraf": "^4.16.3",
    "dotenv": "^16.4.5",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
