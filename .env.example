# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=123456789

# Solana RPC (recomendado Helius o QuickNode)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Contraseña maestra para desencriptar el almacén de llaves
MASTER_PASSWORD=change_me_to_a_strong_password

# Ruta del almacén (en Railway usa /data con un Volume)
DATA_DIR=./data

# Opcional
EXPECTED_WALLET_COUNT=50
